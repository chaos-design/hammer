{
  "name": "@chaos-design/hammer",
  "version": "0.1.0",
  "description": "Tooling packages for building a monorepo project.",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "build": "pnpm -r --filter './packages/**' run build",
    "dev": "pnpm -r --parallel --filter='./packages/**' run dev",
    "test": "pnpm -r --filter './packages/**' run test",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "generate-packages-info": "node ./scripts/get-package-info.mjs",
    "verify-publishable": "node ./scripts/verify-publishable.mjs",
    "verify-peers": "node ./scripts/verify-peers.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm verify-publishable && pnpm verify-peers",
    "publish-pkg": "node ./scripts/publish-ci.mjs",
    "prepublishOnly": "node ./scripts/guard-root-publish.mjs",
    "changelog": "node ./scripts/changelog.mjs",
    "render-assets": "node ./scripts/render-assets.mjs",
    "docs:dev": "pnpm --filter @chaos-design/hammer-docs run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaos-design/hammer.git",
    "directory": ""
  },
  "keywords": [
    "monorepo",
    "pnpm",
    "tooling",
    "chaos-design"
  ],
  "author": "Rain120",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched",
      "git add"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@changesets/cli": "3.0.3",
    "@chaos-design/utils-pkg": "workspace:*",
    "@types/node": "^22.10.7",
    "conventional-changelog-cli": "^4.1.0",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.28.1"
}
