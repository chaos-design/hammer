{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // Resolve to source, not to a build artifact: `tsc` must work on a clean
      // checkout, before any sibling package has been built.
      "@chaos-design/package": ["../package/src/index.ts"]
    }
  },
  "include": ["src", "tsup.config.ts"],
  "exclude": ["node_modules", "dist"]
}
