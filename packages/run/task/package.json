{
  "name": "@chaos-design/task",
  "type": "module",
  "version": "0.1.0",
  "description": "Fluent interface for run task.",
  "license": "MIT",
  "keywords": [
    "fluent",
    "chain",
    "task",
    "chaos-design"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaos-design/hammer.git",
    "directory": "packages/run/task"
  },
  "homepage": "https://github.com/chaos-design/hammer/tree/main/packages/run/task#readme",
  "bugs": {
    "url": "https://github.com/chaos-design/hammer/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@chaos-design/tsconfig": "workspace:*",
    "@types/node": "^20.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
